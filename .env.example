# Copy to .env and fill in real values (the .env file is gitignored).
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
SECRET_KEY=replace-with-a-long-random-secret

# Encrypts student PII at rest (parent names, phone, address, blood group).
# Generate a key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separate multiple keys to rotate (first encrypts, all can decrypt).
# Leave unset to store PII as plaintext (not recommended in production).
PII_ENCRYPTION_KEY=

# Records past this many years (for inactive/left students) are anonymized by
# `flask retention-sweep --apply`.
DATA_RETENTION_YEARS=7

# Google Sign-In (invitation acceptance + login). Create an OAuth 2.0 Web
# client at https://console.cloud.google.com/apis/credentials and add your
# app origin (e.g. http://localhost:3000) to "Authorized JavaScript origins".
# Leave unset to disable Google sign-in (invites fall back to password setup).
GOOGLE_CLIENT_ID=

# --- Email delivery (invitations + password resets) ------------------------
# Works with any SMTP provider (Resend, Brevo, SendGrid, Mailgun, Gmail
# app-password...). If left unset, links are written to the server logs instead
# of emailed, so onboarding still works manually. Turn on real delivery by
# filling these in. APP_BASE_URL is your public site URL, used to build the
# clickable links inside the emails.
APP_BASE_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=School App <noreply@yourschool.com>
# Set SMTP_USE_SSL=1 only if your provider uses implicit TLS on port 465.
SMTP_USE_SSL=0
